+typedef enum KVMHostHybridType {
+    KVM_HOST_HYBRID_NONE,
+    KVM_HOST_HYBRID_INTEL,
+    KVM_HOST_HYBRID_AMD,
+} KVMHostHybridType;
+
+static unsigned long *kvm_performance_cpus;
+static unsigned long kvm_performance_cpus_nbits;
+static gsize kvm_performance_cpus_initialized;
+
+static int kvm_host_amd_core_type(void)
+{
+    uint32_t eax, ebx, ecx, edx;
+    int i;
+
+    for (i = 0; i < 32; i++) {
+        host_cpuid(0x80000026, i, &eax, &ebx, &ecx, &edx);
+        if (!(ebx & 0xffff)) {
+            break;
+        }
+        if (((ecx >> 8) & 0xff) == 1) {
+            return ebx >> 28;
+        }
+    }
+
+    return -1;
+}
+
+static KVMHostHybridType kvm_host_hybrid_type(void)
+{
+    char vendor[CPUID_VENDOR_SZ + 1];
+    uint32_t eax, ebx, ecx, edx;
+
+    host_cpu_vendor_fms(vendor, NULL, NULL, NULL);
+
+    if (g_str_equal(vendor, CPUID_VENDOR_INTEL)) {
+        host_cpuid(0, 0, &eax, NULL, NULL, NULL);
+        if (eax < 0x1a) {
+            return KVM_HOST_HYBRID_NONE;
+        }
+
+        host_cpuid(7, 0, NULL, NULL, NULL, &edx);
+        return (edx & BIT(15)) ? KVM_HOST_HYBRID_INTEL :
+                                 KVM_HOST_HYBRID_NONE;
+    }
+
+    if (g_str_equal(vendor, CPUID_VENDOR_AMD)) {
+        host_cpuid(0x80000000, 0, &eax, NULL, NULL, NULL);
+        if (eax < 0x80000026) {
+            return KVM_HOST_HYBRID_NONE;
+        }
+
+        host_cpuid(0x80000026, 0, &eax, &ebx, &ecx, &edx);
+        return (eax & BIT(30)) ? KVM_HOST_HYBRID_AMD :
+                                 KVM_HOST_HYBRID_NONE;
+    }
+
+    return KVM_HOST_HYBRID_NONE;
+}
+
+static bool kvm_host_cpu_is_performance(KVMHostHybridType hybrid_type)
+{
+    uint32_t eax;
+
+    if (hybrid_type == KVM_HOST_HYBRID_INTEL) {
+        host_cpuid(0x1a, 0, &eax, NULL, NULL, NULL);
+        return (eax >> 24) == 0x40;
+    }
+
+    if (hybrid_type == KVM_HOST_HYBRID_AMD) {
+        return kvm_host_amd_core_type() == 0;
+    }
+
+    return false;
+}
+
+static int kvm_init_performance_core_affinity(CPUState *cs)
+{
+    unsigned long *allowed_cpus = NULL;
+    unsigned long *performance_cpus = NULL;
+    unsigned long *single_cpu = NULL;
+    unsigned long nbits = 0;
+    unsigned long host_cpu;
+    KVMHostHybridType hybrid_type;
+    int err = 0;
+    int restore_err;
+
+    hybrid_type = kvm_host_hybrid_type();
+    if (hybrid_type == KVM_HOST_HYBRID_NONE) {
+        return 0;
+    }
+
+    err = qemu_thread_get_affinity(cs->thread, &allowed_cpus, &nbits);
+    if (err) {
+        return 0;
+    }
+
+    performance_cpus = bitmap_new(nbits);
+    single_cpu = bitmap_new(nbits);
+
+    host_cpu = find_first_bit(allowed_cpus, nbits);
+    while (host_cpu < nbits) {
+        bitmap_zero(single_cpu, nbits);
+        set_bit(host_cpu, single_cpu);
+
+        err = qemu_thread_set_affinity(cs->thread, single_cpu, nbits);
+        if (err) {
+            break;
+        }
+        if (kvm_host_cpu_is_performance(hybrid_type)) {
+            set_bit(host_cpu, performance_cpus);
+        }
+
+        host_cpu = find_next_bit(allowed_cpus, nbits, host_cpu + 1);
+    }
+
+    restore_err = qemu_thread_set_affinity(cs->thread, allowed_cpus, nbits);
+    if (restore_err) {
+        warn_report("failed to restore KVM vCPU thread affinity after "
+                    "performance-core probing: %s",
+                    strerror(restore_err < 0 ? -restore_err : restore_err));
+    }
+    if (!err && !restore_err &&
+        !bitmap_empty(performance_cpus, nbits) &&
+        !bitmap_equal(performance_cpus, allowed_cpus, nbits)) {
+        kvm_performance_cpus = performance_cpus;
+        kvm_performance_cpus_nbits = nbits;
+        performance_cpus = NULL;
+    }
+
+    g_free(single_cpu);
+    g_free(performance_cpus);
+    g_free(allowed_cpus);
+
+    return restore_err > 0 ? -restore_err : restore_err;
+}
+
+static int kvm_apply_performance_core_affinity(CPUState *cs)
+{
+    int err = 0;
+
+    if (g_once_init_enter(&kvm_performance_cpus_initialized)) {
+        err = kvm_init_performance_core_affinity(cs);
+        g_once_init_leave(&kvm_performance_cpus_initialized, 1);
+    }
+    if (err < 0) {
+        return err;
+    }
+
+    if (!kvm_performance_cpus) {
+        return 0;
+    }
+
+    err = qemu_thread_set_affinity(cs->thread, kvm_performance_cpus,
+                                   kvm_performance_cpus_nbits);
+    if (err) {
+        warn_report("failed to restrict KVM vCPU thread to performance "
+                    "cores: %s", strerror(err < 0 ? -err : err));
+    }
+
+    return 0;
+}
